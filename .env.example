# ───────── تنظیمات ربات «بلد باش» ─────────
# این فایل را به .env کپی کنید و مقادیر را پر کنید.

# توکن ربات از @BotFather
BOT_TOKEN=

# آدرس عمومی HTTPS مینی‌اپ (همان آدرسی که این سرور روی آن در دسترس است)
# مثال: https://baladbash.example.com
WEBAPP_URL=

# پورت سرور
PORT=3000

# شناسه عددی تلگرام ادمین‌ها (با ویرگول جدا کنید) — برای تأیید سوالات و آمار
ADMIN_IDS=

# اگر در BotFather برای ربات «Main Mini App» تنظیم کرده‌اید true بگذارید
# تا لینک‌های دعوت مستقیم مینی‌اپ را باز کنند (t.me/bot?startapp=...)
MAIN_MINIAPP=false

# فروش سکه با ستاره‌های تلگرام (Telegram Stars)
STARS_SHOP=false

# چند ثانیه بعد از شروع بازی شانسی، اگر حریف واقعی پیدا نشد ربات تمرینی وارد شود
BOT_JOIN_DELAY_SEC=20

# مهلت هر نوبت (ساعت) — بعد از آن بازیکنِ غایب بازنده می‌شود
TURN_TIMEOUT_HOURS=24

# مسیر فایل دیتابیس
DB_PATH=./data/baladbash.db

# پروکسی برای اتصال به api.telegram.org (اختیاری)
# مثال: socks5://127.0.0.1:1080  یا  http://127.0.0.1:8080
PROXY_URL=

# آدرس سرور Bot API اختصاصی (اختیاری)
TELEGRAM_API_ROOT=

# فقط برای تست محلی در مرورگر! در محیط واقعی حتماً false باشد.
# با فعال بودن، می‌توانید با ?dev=1 بدون تلگرام وارد شوید.
DEV_AUTH=false
