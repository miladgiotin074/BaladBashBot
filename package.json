{
  "name": "balad-bash-bot",
  "version": "1.0.0",
  "description": "بلد باش — ربات تلگرام چالش اطلاعات عمومی با مینی‌اپ",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
